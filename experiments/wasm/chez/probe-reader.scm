(import (chezscheme))
(define (show label thunk)
  (display label) (display " ")
  (guard (e (#t (display "ERROR: ") (display (condition-message e))))
    (write (thunk)))
  (newline))
(show 'reader-hash-bang (lambda () (read (open-input-string "#!fold-case\nABC"))))
(show 'reader-eval (lambda () (read (open-input-string "#.(+ 1 2)"))))
(show 'reader-datum-comment (lambda () (read (open-input-string "#;(+ 1 2) 9"))))
(show 'reader-label (lambda () (read (open-input-string "#0=(1 . #0#)"))))
(show 'reader-vector (lambda () (read (open-input-string "#(1 2)"))))
