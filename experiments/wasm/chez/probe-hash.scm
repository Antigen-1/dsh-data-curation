(import (chezscheme))

(define (probe name thunk)
  (display name)
  (display " => ")
  (guard (e (#t (display "ERROR: ") (display (condition-message e))))
    (let ((v (thunk)))
      (cond
        ((bytevector? v) (display "bytevector:") (display (bytevector-length v)))
        (else (write v)))))
  (newline))

(probe 'scheme-version (lambda () (scheme-version)))
(probe 'sha256-bound (lambda () (top-level-bound? 'sha256)))
(probe 'compute-sha256-bound (lambda () (top-level-bound? 'compute-sha256)))
(probe 'string-hash-bound (lambda () (top-level-bound? 'string-hash)))
(probe 'sha256 (lambda () (sha256 (string->utf8 "abc"))))
(probe 'compute-sha256 (lambda () (compute-sha256 (string->utf8 "abc"))))
(probe 'string-hash (lambda () (string-hash "abc")))
(probe 'read-comment (lambda () (read (open-input-string "; c\n'(1 2)"))))
(probe 'read-number (lambda () (list (read (open-input-string "#xFF")) (read (open-input-string "255")))))
(probe 'read-case (lambda () (read (open-input-string "ABC"))))
(probe 'read-string (lambda () (read (open-input-string "\"a\\x41;b\""))))
