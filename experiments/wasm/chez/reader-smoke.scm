(load "/source-tree-reader.scm")

(define (show label source)
  (display label)
  (display " ")
  (display (tree-hash source))
  (newline))

(show "integer" "42")
(show "hex" "#xFF")
(show "quote" "'x")
(show "quote-list" "(quote x)")
(show "rational" "1/2")
(show "real" "1.5")
(show "bytevector" "#vu8(0 255)")
(show "string" "\"a\\n\"")
(show "char" "#\\x41")
(show "list" "(a b)")
(show "vector" "#(1 2)")
(show "boolean" "#true")
(show "boolean-false" "#f")
(show "null" "()")
(show "nested" "(a (b #(1 2)) \"x\")")
(exit 0)

