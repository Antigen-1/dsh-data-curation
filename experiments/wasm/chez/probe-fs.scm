(import (chezscheme))
(define (show label thunk)
  (display label) (display " ")
  (guard (e (#t (display "ERROR: ") (display (condition-message e))))
    (write (thunk)))
  (newline))
(show 'cwd (lambda () (current-directory)))
(show 'root (lambda () (directory-list "/")))
(show 'write (lambda ()
  (call-with-output-file "/tmp/tree-probe.txt"
    (lambda (port) (display "hello-memfs" port)))))
(show 'read (lambda ()
  (let ((port (open-input-file "/tmp/tree-probe.txt")))
    (let ((line (get-line port)))
      (close-port port)
      line))))
(show 'libdirs (lambda () (library-directories)))
(show 'libext (lambda () (library-extensions)))
