{
  "version": 3,
  "valid": [
    { "id": "integer", "source": "42" },
    { "id": "negative-integer", "source": "-7" },
    { "id": "hex", "source": "#xFF" },
    { "id": "binary", "source": "#b101" },
    { "id": "octal", "source": "#o17" },
    { "id": "rational", "source": "1/2" },
    { "id": "negative-rational", "source": "-3/4" },
    { "id": "real", "source": "1.5" },
    { "id": "exponent", "source": "1e3" },
    { "id": "negative-real", "source": "-0.5" },
    { "id": "positive-infinity", "source": "+inf.0" },
    { "id": "canonical-nan", "source": "+nan.0" },
    { "id": "symbol", "source": "a" },
    { "id": "operator-symbol", "source": "+" },
    { "id": "string", "source": "\"a\\n\"" },
    { "id": "string-hex", "source": "\"\\x41;\"" },
    { "id": "char-name", "source": "#\\space" },
    { "id": "char-hex", "source": "#\\x41" },
    { "id": "empty-list", "source": "()" },
    { "id": "list", "source": "(a b)" },
    { "id": "quote", "source": "'x" },
    { "id": "quote-list", "source": "(quote x)" },
    { "id": "vector", "source": "#(1 2)" },
    { "id": "bytevector", "source": "#vu8(0 255)" },
    { "id": "boolean-true", "source": "#true" },
    { "id": "boolean-false", "source": "#f" },
    { "id": "nested", "source": "(a (b #(1 2)) \"x\")" },
    { "id": "line-comment", "source": "; hello\n42" },
    { "id": "block-comment", "source": "#| outer #| inner |# |# 42" }
  ],
  "cases": [
    { "id": "close", "source": ")", "expect": "E-READ", "kind": "read-error" },
    { "id": "open", "source": "(", "expect": "E-READ", "kind": "read-error" },
    { "id": "dotted", "source": "(a . b)", "expect": "E-DOTTED", "kind": "datum-error" },
    { "id": "multi-form-dotted", "source": "(ok)\n(a . b)", "expect": "E-DOTTED", "kind": "datum-error", "line": 2, "column": 1 },
    { "id": "complex", "source": "1+2i", "expect": "E-DATUM", "kind": "datum-error" },
    { "id": "quasiquote", "source": "`x", "expect": "NO-ERROR", "kind": "readable" },
    { "id": "unquote", "source": ",x", "expect": "NO-ERROR", "kind": "readable" },
    { "id": "reader-comment", "source": "#;1", "expect": "NO-ERROR", "kind": "readable" },
    { "id": "directive", "source": "#!fold-case", "expect": "NO-ERROR", "kind": "readable" },
    { "id": "bad-radix", "source": "#x", "expect": "E-READ", "kind": "read-error" },
    { "id": "unterminated-string", "source": "\"abc", "expect": "E-READ", "kind": "read-error" },
    { "id": "bad-char", "source": "#\\x110000", "expect": "E-READ", "kind": "read-error" },
    { "id": "zero-denominator", "source": "1/0", "expect": "E-READ", "kind": "read-error" },
    { "id": "bad-exponent", "source": "1e", "expect": "NO-ERROR", "kind": "readable" },
    { "id": "unknown-sharp", "source": "#z", "expect": "E-READ", "kind": "read-error" },
    { "id": "bad-symbol", "source": "1abc", "expect": "NO-ERROR", "kind": "readable" },
    { "id": "bytevector-range", "source": "#vu8(256)", "expect": "E-READ", "kind": "read-error" },
    { "id": "bytevector-eof", "source": "#vu8(1", "expect": "E-READ", "kind": "read-error" },
    { "id": "vector-eof", "source": "#(1", "expect": "E-READ", "kind": "read-error" },
    { "id": "block-comment-eof", "source": "#| open", "expect": "E-READ", "kind": "read-error" }
  ]
}
