(define (show label value)
  (display label) (display " ") (write value) (newline))

(define (guard-value thunk)
  (guard (e (#t (list 'error (condition-message e))))
    (thunk)))

(define base "(define (double x) (* x 2))")
(define spaced "; comment\n(define  (double x)\n  (* x 2)) ; tail\n")
(define quote-sugar "(define q '(1 2))")
(define quote-explicit "(define q (quote (1 2)))")
(define hex-number "(define n #xFF)")
(define dec-number "(define n 255)")
(define string-escape "(define s \"\\x41;b\")")
(define string-plain "(define s \"Ab\")")
(define changed "(define (double x) (* x 3))")
(define symbol-form "(define s x)")
(define string-form "(define s \"x\")")
(define list-a "(list 1 2)")
(define list-b "(list 2 1)")

(show "tree.space.equal" (string=? (tree-hash base) (tree-hash spaced)))
(show "raw.space.diff" (not (string=? (bytevector->hex (sha256 (string->utf8 base)))
                                       (bytevector->hex (sha256 (string->utf8 spaced))))))
(show "tree.quote.equal" (string=? (tree-hash quote-sugar) (tree-hash quote-explicit)))
(show "tree.number.equal" (string=? (tree-hash hex-number) (tree-hash dec-number)))
(show "tree.string.equal" (string=? (tree-hash string-escape) (tree-hash string-plain)))
(show "tree.changed.diff" (not (string=? (tree-hash base) (tree-hash changed))))
(show "tree.symbol-string.diff" (not (string=? (tree-hash symbol-form) (tree-hash string-form))))
(show "tree.order.diff" (not (string=? (tree-hash list-a) (tree-hash list-b))))
(show "base.tree" (tree-hash base))
(show "base.canonical.hex" (bytevector->hex (canonical-source-bytes base)))

;; Pure-Scheme plugin prototype.
(show "plugin.register" (guard-value (lambda () (register-plugin! "math" "1"
  (list (cons "double" (lambda (x) (* x 2))))))))
(show "plugin.call" (guard-value (lambda () (plugin-call "math" "double" 21))))
(show "plugin.duplicate" (guard-value (lambda () (register-plugin! "math" "1" '()))))
(show "plugin.unknown" (guard-value (lambda () (plugin-call "math" "nope" 1))))
(show "plugin.count" (length plugins))

;; Source rule registration. The plugin id tag is external environment metadata.
(show "rule.register" (guard-value (lambda ()
  (register-rule-source! "org.example.plugin-double" "1"
    "(lambda (x) (plugin-call \"math\" \"double\" x))" "math"))))
(show "rule.call" (guard-value (lambda () (rule-call "org.example.plugin-double" 21))))
(show "rule.duplicate" (guard-value (lambda ()
  (register-rule-source! "org.example.plugin-double" "1" "(lambda (x) x)"))))
(show "rule.invalid-source" (guard-value (lambda ()
  (register-rule-source! "org.example.bad" "1" "(lambda (x)"))))
(show "rule.count" (length rules))
(show "rule.hash.nonempty" (string-length (caddr (rule-ref "org.example.plugin-double"))))
