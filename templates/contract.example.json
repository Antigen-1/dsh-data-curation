{
  "version": 4,
  "fields": [
    {
      "name": "location",
      "type": "text",
      "allowEmpty": false,
      "requireEvidence": true
    },
    {
      "name": "measured_value",
      "type": "number",
      "allowEmpty": true,
      "requireEvidence": true
    },
    {
      "name": "category",
      "type": "enum",
      "allowEmpty": false,
      "requireEvidence": true,
      "synonyms": {
        "标准型": ["常规型", "普通型"]
      }
    },
    {
      "name": "note",
      "type": "text",
      "allowEmpty": true,
      "requireEvidence": false
    }
  ],
  "records": {
    "kind": "file",
    "path": "roster.csv",
    "key": "record_id"
  },
  "delivery": {
    "table": "summary",
    "key": "record_id"
  },
  "channels": [
    { "name": "text", "method": "source-text-layer" },
    { "name": "vision", "method": "model-image" },
    { "name": "ocr", "method": "ocr-fallback" }
  ],
  "normalization": {
    "mode": "safe",
    "caseInsensitive": false,
    "synonyms": {}
  },
  "evidence": {
    "required": true
  },
  "adjudication": {
    "compare": { "builtin": "exact" },
    "select": { "builtin": "first-valid" },
    "fields": {
      "measured_value": { "compare": { "builtin": "numeric", "tolerance": 0 } },
      "note": { "select": { "builtin": "longest" } }
    }
  },
  "gates": {
    "minAcceptedRatio": 0.9,
    "verifyCmd": null
  },
  "identity": {
    "priority": ["record_key", "source_text"],
    "note": "记录键冲突时的取值优先级由项目写明；工具只执行，不自行判断"
  }
}
