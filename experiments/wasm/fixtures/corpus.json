{
  "fixturesVersion": 1,
  "contractVersion": "1.0.0",
  "note": "Expected values come from the current production interpreter at baseline a0d5a4d. Dynamic cases assert observable registration/call behavior only; no v1 AST, pin or hash is compared.",
  "cases": [
    {
      "id": "minimum.eval",
      "tier": "minimum",
      "request": {
        "protocolVersion": 1,
        "id": "minimum.eval",
        "op": "eval",
        "source": "(lambda (x) (+ x 1))",
        "args": [41]
      },
      "expected": { "ok": true, "value": 42 }
    },
    {
      "id": "minimum.dynamic-register",
      "tier": "minimum",
      "request": {
        "protocolVersion": 1,
        "id": "minimum.dynamic-register",
        "op": "load-module",
        "source": "(register-rule! \"org.example.smoke\" \"1\" (lambda (x) (number? x)))",
        "calls": [{ "rule": "org.example.smoke", "args": [1] }]
      },
      "expected": {
        "ok": true,
        "stateIds": ["org.example.smoke"],
        "ids": ["org.example.smoke"],
        "calls": [{ "rule": "org.example.smoke", "ok": true, "value": true }]
      }
    },
    {
