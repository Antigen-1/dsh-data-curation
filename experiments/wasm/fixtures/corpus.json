    {
      "id": "dynamic.loop-snapshot",
      "tier": "dynamic",
      "request": {
        "protocolVersion": 1,
        "id": "dynamic.loop-snapshot",
        "op": "load-module",
        "source": "(define (rule-id n) (string-append \"org.example.dynamic.\" (number->string n))) (let loop ((i 0)) (if (< i 3) (begin (register-rule! (rule-id i) \"1\" (lambda (x) (= x i))) (loop (+ i 1))) #f))",
        "calls": [
          { "rule": "org.example.dynamic.0", "args": [0] },
          { "rule": "org.example.dynamic.1", "args": [0] },
          { "rule": "org.example.dynamic.2", "args": [2] }
        ]
      },
      "expected": {
        "ok": true,
        "stateIds": ["org.example.dynamic.0", "org.example.dynamic.1", "org.example.dynamic.2"],
        "ids": ["org.example.dynamic.0", "org.example.dynamic.1", "org.example.dynamic.2"],
        "calls": [
          { "rule": "org.example.dynamic.0", "ok": true, "value": true },
          { "rule": "org.example.dynamic.1", "ok": true, "value": false },
          { "rule": "org.example.dynamic.2", "ok": true, "value": true }
        ]
      }
    },
    {
      "id": "dynamic.local-forms",
