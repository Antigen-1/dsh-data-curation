        "protocolVersion": 1,
        "id": "dynamic.local-forms",
        "op": "load-module",
        "source": "(register-rule! \"local.set\" \"1\" (lambda (x) (let ((n 0)) (set! n (+ n 1)) (= n x)))) (register-rule! \"local.loop\" \"1\" (lambda (x) (let loop ((n 0)) (if (= n x) #t (loop (+ n 1)))))) (register-rule! \"local.let-star\" \"1\" (lambda (x) (let* ((a x) (b (+ a 1))) (= b 2)))) (register-rule! \"primitive.number\" \"1\" number?)",
        "calls": [
          { "rule": "local.set", "args": [1] },
          { "rule": "local.loop", "args": [4] },
          { "rule": "local.let-star", "args": [1] },
          { "rule": "primitive.number", "args": [1] },
          { "rule": "primitive.number", "args": ["1"] }
        ]
      },
      "expected": {
        "ok": true,
        "stateIds": ["local.let-star", "local.loop", "local.set", "primitive.number"],
        "ids": ["local.let-star", "local.loop", "local.set", "primitive.number"],
        "calls": [
          { "rule": "local.set", "ok": true, "value": true },
          { "rule": "local.loop", "ok": true, "value": true },
          { "rule": "local.let-star", "ok": true, "value": true },
          { "rule": "primitive.number", "ok": true, "value": true },
          { "rule": "primitive.number", "ok": true, "value": false }
        ]
