(import (chezscheme))
(define (show label thunk)
  (display label) (display " ")
  (guard (e (#t (display "ERROR: ") (display (condition-message e))))
    (write (thunk)))
  (newline))
(define ns (environment '(only (rnrs) + - * = display)))
(show 'only-eval (lambda () (eval '(+ 1 2) ns)))
(show 'only-file (lambda () (eval '(open-input-file "x") ns)))
(show 'only-import (lambda () (eval '(import (chezscheme)) ns)))
