        "source": "(define (positive? x) (and (number? x) (> x 0))) (define (over? x) (positive? x)) (define (register id role predicate) (register-rule! id \"1\" predicate (object \"role\" role \"description\" \"loaded from Scheme\"))) (register \"org.example.positive\" \"decision\" (lambda (x) (positive? x))) (register \"org.example.over\" \"merge\" (lambda (x) (over? x)))",
