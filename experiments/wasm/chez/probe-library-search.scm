(import (chezscheme))
(define (reject who path dirs exts)
  (display "SEARCH ") (write path) (newline)
  (values #f #f #f))
(parameterize ([library-search-handler reject])
  (display "chez:")
  (guard (e (#t (display "ERR ") (write (condition-message e)) (newline)))
    (environment '(chezscheme))
    (display "OK") (newline))
  (display "rnrs:")
  (guard (e (#t (display "ERR ") (write (condition-message e)) (newline)))
    (environment '(rnrs base (6)))
    (display "OK") (newline)))
(exit 0)
