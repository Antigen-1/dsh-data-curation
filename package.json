{
  "name": "dsh-data-curation",
  "version": "0.4.0",
  "description": "Contract-driven data curation mode for DeepSeek Harness: immutable-source gates, independent multi-channel extraction, contract-declared adjudication strategies (built-in or project commands, per-field overrides), a single SQLite workspace (contract, exporters, decisions, ledger, curated table) with cell-level provenance, packable project archives, and a generic session progress dock. 契约驱动的数据核对/清洗模式。",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "data-curation",
    "data-cleaning",
    "data-quality",
    "provenance",
    "adjudication",
    "sqlite",
    "audit"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "lib",
    "assets",
    "templates",
    "scripts/selfcheck.mjs",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test",
    "selfcheck": "node scripts/selfcheck.mjs",
    "prepack": "npm run selfcheck && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": ">=0.1.2-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-skill": ">=0.1.2-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.2-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "author": "Antigen-1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Antigen-1/dsh-data-curation.git"
  },
  "homepage": "https://github.com/Antigen-1/dsh-data-curation#readme",
  "bugs": {
    "url": "https://github.com/Antigen-1/dsh-data-curation/issues"
  }
}
